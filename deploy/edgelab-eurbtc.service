[Unit]
Description=edgelab EUR+BTC bot (Pepperstone cTrader demo — 2nd instance, shared main app/token)
After=network-online.target edgelab.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/edgelab-eurbtc
# .env holds the shared app Client ID/Secret, this bot's Pepperstone account id, the shared token-store
# path, and Telegram + EDGELAB_LABEL (see deploy/eurbtc.env.example). Plain KEY=value lines, no quotes.
EnvironmentFile=/home/ubuntu/edgelab-eurbtc/.env
Environment=PYTHONUNBUFFERED=1
# EUR+BTC subset at 0.75% risk on the ~$5k demo. --no-refresh: consume the main bot's token, never
# refresh it (the main bot is the sole refresher, so the two never rotate each other out). 20% kill-switch.
ExecStart=/home/ubuntu/edgelab-eurbtc/.venv/bin/python examples/run_basket.py --live --timeframe H4 --symbols EURUSD BTCUSD --risk-pct 0.75 --account-max-dd 20 --no-refresh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
